@@ -19,6 +21,26 @@
 
 #define DAMAGE_REGION_COUNT 16
 
+static bool focaldesk_bt2020_sdr(void) {
+	const char *value = getenv("FOCALDESK_PORTAL_COLOR");
+	return value != NULL &&
+		(strcmp(value, "bt2020-sdr") == 0 ||
+		 strcmp(value, "rec2020-sdr") == 0 ||
+		 strcmp(value, "wide-sdr") == 0);
+}
+
+static void add_focaldesk_colorimetry(struct spa_pod_builder *b) {
+	if (!focaldesk_bt2020_sdr()) {
+		return;
+	}
+	spa_pod_builder_add(b,
+		SPA_FORMAT_VIDEO_colorRange, SPA_POD_Id(SPA_VIDEO_COLOR_RANGE_0_255),
+		SPA_FORMAT_VIDEO_colorMatrix, SPA_POD_Id(SPA_VIDEO_COLOR_MATRIX_RGB),
+		SPA_FORMAT_VIDEO_transferFunction, SPA_POD_Id(SPA_VIDEO_TRANSFER_BT709),
+		SPA_FORMAT_VIDEO_colorPrimaries, SPA_POD_Id(SPA_VIDEO_COLOR_PRIMARIES_BT2020),
+		0);
+}
+
 static struct spa_pod *build_buffer(struct spa_pod_builder *b, uint32_t blocks, uint32_t size,
 		uint32_t stride, uint32_t datatype) {
 	assert(blocks > 0);
@@ -75,6 +97,7 @@ static struct spa_pod *fixate_format(struct spa_pod_builder *b, enum spa_video_f
 			&SPA_FRACTION(1, 1),
 			&SPA_FRACTION(framerate, 1)),
 		0);
+	add_focaldesk_colorimetry(b);
 	return spa_pod_builder_pop(b, &f[0]);
 }
 
