{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focaldesk Archiver",
  "version": "0.1.0",
  "identifier": "com.focaldesk.archiver",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Focaldesk Archiver", "width": 1040, "height": 760, "minWidth": 760, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
