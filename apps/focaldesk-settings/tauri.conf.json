{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocalDesk Settings Preview",
  "version": "0.1.0",
  "identifier": "org.focaldesk.settings.preview",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "devUrl": "http://localhost:1422",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [{"label":"main","title":"FocalDesk Settings Preview","width":1120,"height":800,"minWidth":720,"minHeight":580}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {"active":false}
}
