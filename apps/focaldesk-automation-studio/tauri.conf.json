{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocalDesk Automation Studio",
  "version": "0.1.0",
  "identifier": "org.focaldesk.automation-studio",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FocalDesk Automation Studio",
        "width": 1480,
        "height": 940,
        "minWidth": 1060,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
