use tracing_subscriber::EnvFilter;

use flowstate_engine::core::app::CoreInit;
use flowstate_engine::backend;

fn main() -> Result<(), Box<dyn std::error::Error>>  {

    if let Err(e) = tracing_subscriber::fmt()
        .with_env_filter(EnvFilter::from_default_env())
        .try_init()
    {
        eprintln!("tracing already initialized: {e}");
    }
    
    let CoreInit { display, app } = CoreInit::new()?;
    
    let backend = std::env::args().nth(1).unwrap_or_else(|| "winit".to_string());

    match backend.as_str() {
	"winit" => flowstate_engine::minimal_core::winit::run(display, app)?,
	"drm"   => flowstate_engine::minimal_core::drm::run(display, app)?,
        other   => {
            eprintln!("unknown backend: {other} (use: winit | drm)");
            std::process::exit(2);
        }
    }
    
    Ok(())
}
