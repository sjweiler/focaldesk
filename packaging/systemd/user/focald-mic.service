[Unit]
Description=FocalDesk push-to-talk microphone daemon
PartOf=focaldesk-session.target
Wants=pipewire.service wireplumber.service focald-voice.service focald-speech.service
After=pipewire.service wireplumber.service focald-voice.service focald-speech.service

[Service]
Type=simple
ExecStart=%h/.local/bin/focald-mic
Restart=on-failure
RestartSec=2
Environment=FOCALD_MIC_SOCKET=%t/focaldesk/focald-mic.sock
Environment=FOCALD_VOICE_SOCKET=%t/focaldesk/focald-voice.sock
Environment=FOCALD_SPEECH_SOCKET=%t/focaldesk/focald-speech.sock
UMask=0077
NoNewPrivileges=yes
LimitCORE=0

[Install]
WantedBy=focaldesk-session.target
