[Unit]
Description=Import GNOME Keyring into Focaldesk credential storage
PartOf=focaldesk-session.target
Before=focald-secrets.service
ConditionPathExists=%t/focaldesk/secrets.key

[Service]
Type=oneshot
ExecStart=%h/.local/bin/focald-secrets-import-gnome-keyring --import --if-available
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
ReadWritePaths=%h/.local/share/focaldesk
TimeoutStartSec=45
