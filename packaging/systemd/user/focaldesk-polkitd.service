[Unit]
Description=FocalDesk PolicyKit authentication agent
PartOf=focaldesk-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/focaldesk-polkitd
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=yes
LimitCORE=0

[Install]
WantedBy=focaldesk-session.target
