[Unit]
Description=FocalDesk voice intent daemon
PartOf=focaldesk-session.target
After=focaldesk-controlsd.service

[Service]
ExecStart=/usr/bin/focald-voice
Restart=on-failure
Environment=FOCALD_VOICE_SOCKET=%t/focaldesk/focald-voice.sock
UMask=0077
NoNewPrivileges=yes
LimitCORE=0

[Install]
WantedBy=focaldesk-session.target
