[Unit]
Description=Focaldesk credential broker
PartOf=focaldesk-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/focald-secrets
Environment=RUST_LOG=info
UMask=0077
# User-local development fallback. Set FOCALD_SECRETS_KEYFILE explicitly.
Restart=no
NoNewPrivileges=yes
LimitCORE=0
MemoryDenyWriteExecute=yes
LimitMEMLOCK=128M
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
ReadWritePaths=%h/.local/share/focaldesk
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/focaldesk

[Install]
WantedBy=focaldesk-session.target
