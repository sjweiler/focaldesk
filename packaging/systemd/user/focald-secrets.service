[Unit]
Description=Focaldesk credential broker
PartOf=focaldesk-session.target
Requires=focald-secrets.socket
Wants=focald-secrets-import.service
After=focald-secrets.socket focald-secrets-import.service
ConditionPathExists=%t/focaldesk/secrets.key

[Service]
Type=simple
ExecStart=%h/.local/bin/focald-secrets
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
LimitMEMLOCK=128M
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
ReadWritePaths=%h/.local/share/focaldesk
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/focaldesk

[Install]
WantedBy=focaldesk-session.target
