[Unit]
Description=FocalDesk experimental external dock
PartOf=focaldesk-session.target focaldesk-panel.service
Requires=focaldesk-panel.service
After=focaldesk-session.target focaldesk-panel.service

[Service]
Type=simple
ExecStart=%h/.local/bin/focal-dock
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=10
