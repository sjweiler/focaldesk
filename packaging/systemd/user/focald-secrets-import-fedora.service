[Unit]
Description=Import GNOME Keyring into Focaldesk credential storage
PartOf=focaldesk-session.target
Before=focald-secrets.service

[Service]
Type=oneshot
ExecStart=/usr/bin/focald-secrets-import-gnome-keyring --import --if-available
UMask=0077
NoNewPrivileges=yes
LimitCORE=0
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
ReadWritePaths=%h/.local/share/focaldesk
TimeoutStartSec=45
