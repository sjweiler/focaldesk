[Unit]
Description=FocalDesk server
PartOf=focaldesk-session.target
Wants=focal-vector.service
After=focaldesk-dialogd.service focal-vector.service

[Service]
Type=simple
ExecStart=/usr/bin/focaldesk-server
Restart=on-failure
RestartSec=2
Environment=FOCALDESK_AI_SOCKET=%t/focaldesk/focaldesk-ai.sock
Environment=FOCALDESK_CONTROL_CENTER_SOCKET=%t/focaldesk/control-center.sock
Environment=FOCAL_VECTOR_SOCKET=%t/focaldesk/focal-vector.sock
Environment=FOCALDESK_MEMORY_BACKEND=focal-vector
EnvironmentFile=-%h/.config/focaldesk/focaldesk-server.env
# The boot service has no reliable terminal for an interactive fallback. Allow
# chat for this logged-in session so the console can reach configured providers.
Environment=FOCALDESK_AI_PERMISSION=allow-session
KillSignal=SIGINT
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=yes
LimitCORE=0

[Install]
WantedBy=focaldesk-session.target
