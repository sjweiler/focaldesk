[Unit]
Description=Watch for the Focaldesk credential broker key for UID %i
Requires=user-runtime-dir@%i.service
After=user-runtime-dir@%i.service
PartOf=user@%i.service

[Path]
# Only PAM can create this root-only file. Starting from the credential path,
# instead of the public client socket, prevents pre-unlock desktop clients from
# repeatedly starting the broker without a key and poisoning the systemd start
# limit for the rest of the login session.
PathExists=/run/focald-secrets/%i/master
Unit=focald-secrets@%i.service
