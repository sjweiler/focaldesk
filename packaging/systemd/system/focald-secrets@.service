[Unit]
Description=Focaldesk credential broker for UID %i
Documentation=man:systemd.exec(5)
Requires=user@%i.service
After=user@%i.service
BindsTo=user@%i.service

[Service]
Type=simple
User=%i
LoadCredential=focald.master:/run/focald-secrets/%i/master
Environment=RUST_LOG=info
Environment=XDG_RUNTIME_DIR=/run/user/%i
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%i/bus
Environment=FOCALD_SECRETS_DB=/var/lib/focald-secrets/%i/secrets.db
Environment=FOCALD_SECRETS_ACL=/etc/focaldesk/secrets-acl.toml
Environment=FOCALD_SECRETS_REQUIRE_MLOCK=1
ExecStart=/usr/bin/focald-secrets
TimeoutStartSec=15s
UMask=0077
Restart=no
StateDirectory=focald-secrets/%i
StateDirectoryMode=0700

# The credential is copied by PID 1 into this service's private, read-only
# ramfs. Mount namespacing prevents other same-UID services from seeing it.
PrivateMounts=yes
NoNewPrivileges=yes
LimitCORE=0
LimitMEMLOCK=384M
LimitNOFILE=512
TasksMax=128
MemoryMax=512M
MemorySwapMax=0
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=ptraceable
KeyringMode=private
IPAddressDeny=any
ReadWritePaths=/run/user/%i
