policy_module(focaldesk_secrets, 1.0.0)

gen_require(`
    type xdm_t;
')

# The display manager's PAM stack unwraps and may atomically replace the
# password-wrapped broker key while it is still running in xdm_t.  Generic
# user data is intentionally not readable from that domain, so keep the
# exception confined to Focaldesk's private secrets directory.
type focaldesk_secrets_home_t;
userdom_user_home_content(focaldesk_secrets_home_t)

# The key lives below ~/.local/share.  Searching only user_home_dir_t lets
# xdm_t enter $HOME but still leaves it unable to traverse data_home_t (the
# normal label on .local and share), which makes openat() fail with EACCES
# before it ever reaches our narrowly labelled directory and key.
userdom_search_user_home_content(xdm_t)
manage_dirs_pattern(xdm_t, focaldesk_secrets_home_t, focaldesk_secrets_home_t)
manage_files_pattern(xdm_t, focaldesk_secrets_home_t, focaldesk_secrets_home_t)
